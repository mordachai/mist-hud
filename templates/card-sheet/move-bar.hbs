<nav class="mh-cs-move-bar">
  {{!-- Portrait: cycles Hide / Portrait / Hero Shot (fixes phase 4); a
        miniature of the actor's portrait, shaped like the current mode. --}}
  <button type="button" class="mh-cs-portrait-toggle" data-action="cyclePortrait" data-mode="{{portrait.mode}}" data-tooltip="{{portrait.tooltip}}" aria-label="{{portrait.tooltip}}"><img src="{{portrait.img}}" alt=""></button>
  {{!-- What the selection adds to the next roll (setting: deck cards, tags + cards, or all). --}}
  <div class="mh-cs-totals" aria-live="polite">
    {{#each moveBar.totals}}
    <span class="mh-cs-total mh-cs-total-{{sign}}" data-tooltip="{{label}}"><span class="mh-cs-total-label">{{label}}</span><span class="mh-cs-total-value">{{value}}</span></span>
    {{/each}}
  </div>
  {{#each moveBar.groups}}
  <div class="mh-cs-move-group mh-cs-move-group-{{key}}{{#unless shown}} hidden{{/unless}}" data-label="{{label}}">
    {{#each moves}}
    {{#if imgSrc}}
    <button type="button" class="mh-cs-move mh-cs-move-img" data-action="rollMove" data-move-id="{{id}}" data-tooltip="{{name}}" aria-label="{{name}}"><img src="{{imgSrc}}" alt=""></button>
    {{else}}
    <button type="button" class="mh-cs-move{{#if size}} mh-cs-move-{{size}}{{/if}}" data-action="rollMove" data-move-id="{{id}}" data-tooltip="{{name}}" aria-label="{{name}}">{{abbr}}</button>
    {{/if}}
    {{/each}}
  </div>
  {{/each}}
  {{#if moveBar.multipleGroups}}
  <button type="button" class="mh-cs-move-toggle" data-action="nextMoveGroup" data-tooltip="{{moveBar.nextLabel}}" aria-label="{{moveBar.nextLabel}}">
    <i class="fa-solid fa-chevron-down"></i>
  </button>
  {{/if}}
</nav>
