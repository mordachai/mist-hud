<nav class="mh-cs-move-bar">
  {{#each moveBar.groups}}
  <div class="mh-cs-move-group mh-cs-move-group-{{key}}{{#unless shown}} hidden{{/unless}}" data-label="{{label}}">
    {{#each moves}}
    <button type="button" class="mh-cs-move{{#if size}} mh-cs-move-{{size}}{{/if}}" data-action="rollMove" data-move-id="{{id}}" data-tooltip="{{name}}" aria-label="{{name}}">{{abbr}}</button>
    {{/each}}
  </div>
  {{/each}}
  {{#if moveBar.multipleGroups}}
  <button type="button" class="mh-cs-move-toggle" data-action="nextMoveGroup" data-tooltip="{{moveBar.nextLabel}}" aria-label="{{moveBar.nextLabel}}">
    <i class="fa-solid fa-chevron-down"></i>
  </button>
  {{/if}}
</nav>
