{{!-- One improvement (theme cards' back, the character card's build-up).
      Edit mode: the name opens the edit dialog, the trash deletes it.
      Play mode (owner): the name posts it to chat and spends a use, as on
      the system sheet. Otherwise plain text.
      Takes: imp (improvementView), desc (show the description under the
      name: the theme cards' back; elsewhere it is the row's tooltip). --}}
<li class="mh-cs-improvement{{#if imp.expended}} expended{{/if}}" data-improvement-id="{{imp.id}}"{{#unless desc}}{{#if imp.description}} data-tooltip="{{imp.description}}"{{/if}}{{/unless}}>
  {{#if imp.edit}}
  <button type="button" class="mh-cs-imp-name mh-cs-edit-name" data-action="editImprovement">{{imp.name}}</button>
  {{else if imp.send}}
  <button type="button" class="mh-cs-imp-name mh-cs-send-name" data-action="sendImprovement" aria-label="{{localize 'MistHUD.cardSheet.sendImprovement' name=imp.name}}">{{imp.name}}</button>
  {{else}}
  <span class="mh-cs-imp-name">{{imp.name}}</span>
  {{/if}}
  {{#if imp.choice}} <span class="mh-cs-imp-choice">({{imp.choice}})</span>{{/if}}
  {{#if imp.uses}}<span class="mh-cs-imp-uses">{{imp.uses}}</span>{{/if}}
  {{#if imp.edit}}
  <button type="button" class="mh-cs-icon-btn mh-cs-delete" data-action="deleteImprovement" data-tooltip="{{localize 'CityOfMist.command.deleteImprovement'}}" aria-label="{{localize 'CityOfMist.command.deleteImprovement'}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
  {{/if}}
  {{#if desc}}{{#if imp.description}}<p class="mh-cs-imp-desc">{{imp.description}}</p>{{/if}}{{/if}}
</li>
