{{!-- The character card (layer 2, plan § 2–3).
      Front: name, player, the game's character fields (City of Mist: Mythos,
      Logos), the Crew block with Help/Hurt per crewmate, and story tags.
      Back: the short description, the build-up track and its improvements
      with their descriptions (when the game has one), then the biography.
      Edit mode (card.edit): inputs for the name, the fields and the short
      description, saved on change; the biography in the core ProseMirror
      editor; build-up + / −. Uses the extras card art (per-system CSS).
      Takes: card (characterCard), layer, back. --}}
<article class="mh-cs-card mh-cs-character-card mh-cs-type-character{{#if card.flipped}} flipped{{/if}}{{#if card.edit}} mh-cs-editable{{/if}}" data-card-id="{{card.id}}" data-owner-id="{{card.ownerId}}">
  {{> "modules/mist-hud/templates/card-sheet/peek-tab.hbs" layer=layer title=card.title}}
  <div class="mh-cs-card-inner"{{#if back}} inert{{/if}}>

    <section class="mh-cs-face mh-cs-front"{{#if card.flipped}} inert{{/if}}>
      {{> "modules/mist-hud/templates/card-sheet/card-band.hbs" title=card.title icon=card.category label=card.themebook}}
      <div class="mh-cs-body">
        {{#if card.edit}}
        <input type="text" class="mh-cs-title mh-cs-character-name mh-cs-name-input" id="{{@root.uid}}-character-name" data-edit="actor" data-field="name" value="{{card.title}}" spellcheck="false" aria-label="{{localize 'MistHUD.cardSheet.characterName'}}" placeholder="{{localize 'MistHUD.cardSheet.characterName'}}">
        {{else}}
        <h3 class="mh-cs-title mh-cs-character-name" data-fit data-fit-lines="2">{{card.title}}</h3>
        {{/if}}
        <dl class="mh-cs-fields">
          {{#if card.player}}
          <div class="mh-cs-field mh-cs-field-player">
            <dt>{{localize "MistHUD.cardSheet.player"}}</dt>
            <dd>{{card.player}}</dd>
          </div>
          {{/if}}
          {{#each card.fields}}
          <div class="mh-cs-field mh-cs-field-{{key}}">
            <dt>{{label}}</dt>
            {{#if ../card.edit}}
            <dd><input type="text" class="mh-cs-hand mh-cs-field-input" id="{{@root.uid}}-character-{{key}}" data-edit="actor" data-field="system.{{key}}" value="{{value}}" aria-label="{{label}}" placeholder="{{label}}"></dd>
            {{else}}
            <dd class="mh-cs-hand{{#unless value}} empty{{/unless}}">{{#if value}}{{value}}{{else}}—{{/if}}</dd>
            {{/if}}
          </div>
          {{/each}}
        </dl>
        <div class="mh-cs-scroll">
          {{#if card.helpHurt}}
          {{!-- Help and Hurt are columns: named once in the heading, one line
                per crewmate a Help / Hurt points at. The owner adds one with
                "+", types the numbers, and (edit mode) deletes a line. --}}
          <h4 class="mh-cs-section mh-cs-crew-head">
            <span class="mh-cs-section-label">{{localize "MistHUD.cardSheet.crew"}}</span>
            {{#if card.own}}
            <button type="button" class="mh-cs-icon-btn mh-cs-add-help-hurt" data-action="addHelpHurt" data-tooltip="{{localize 'MistHUD.cardSheet.helpHurt.addTitle'}}" aria-label="{{localize 'MistHUD.cardSheet.helpHurt.addTitle'}}"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
            {{/if}}
            <span class="mh-cs-juice-col">{{localize "CityOfMist.terms.help"}}</span>
            <span class="mh-cs-juice-col">{{localize "CityOfMist.terms.hurt"}}</span>
            {{#if card.edit}}<span class="mh-cs-juice-trash-col" aria-hidden="true"></span>{{/if}}
          </h4>
          <ul class="mh-cs-crewmates">
            {{#each card.crewmates}}
            <li class="mh-cs-crewmate" data-actor-id="{{id}}">
              <span class="mh-cs-crewmate-name">{{name}}</span>
              {{#if ../card.own}}
              <input type="number" class="mh-cs-juice-col mh-cs-juice-input mh-cs-help{{#unless help}} zero{{/unless}}" id="{{@root.uid}}-help-{{id}}" data-edit="helpHurt" data-kind="help" value="{{help}}" min="0" step="1" aria-label="{{localize 'CityOfMist.terms.help'}}: {{name}}">
              <input type="number" class="mh-cs-juice-col mh-cs-juice-input mh-cs-hurt{{#unless hurt}} zero{{/unless}}" id="{{@root.uid}}-hurt-{{id}}" data-edit="helpHurt" data-kind="hurt" value="{{hurt}}" min="0" step="1" aria-label="{{localize 'CityOfMist.terms.hurt'}}: {{name}}">
              {{else}}
              <span class="mh-cs-juice-col mh-cs-help{{#unless help}} zero{{/unless}}" aria-label="{{localize 'CityOfMist.terms.help'}} {{help}}">{{help}}</span>
              <span class="mh-cs-juice-col mh-cs-hurt{{#unless hurt}} zero{{/unless}}" aria-label="{{localize 'CityOfMist.terms.hurt'}} {{hurt}}">{{hurt}}</span>
              {{/if}}
              {{#if ../card.edit}}
              <button type="button" class="mh-cs-icon-btn mh-cs-delete" data-action="deleteHelpHurt" data-tooltip="{{localize 'MistHUD.cardSheet.helpHurt.deleteHint'}}" aria-label="{{localize 'MistHUD.cardSheet.helpHurt.deleteTitle'}}: {{name}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
              {{/if}}
            </li>
            {{else}}
            <li class="mh-cs-none">{{localize "MistHUD.cardSheet.noHelpHurt"}}</li>
            {{/each}}
          </ul>
          {{/if}}
          <h4 class="mh-cs-section mh-cs-story-head">
            <span class="mh-cs-section-label">{{localize "CityOfMist.terms.storyTags"}}</span>
            {{#if card.own}}
            <button type="button" class="mh-cs-icon-btn" data-action="createDeckItem" data-kind="tag" data-origin="character" data-tooltip="{{localize 'MistHUD.cardSheet.deck.createStoryTag'}}" aria-label="{{localize 'MistHUD.cardSheet.deck.createStoryTag'}}"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
            {{/if}}
          </h4>
          <ul class="mh-cs-tags mh-cs-story-tags">
            {{#each card.storyTags}}
            <li class="mh-cs-tag mh-cs-story-tag {{burnState}}{{#if temporary}} temporary{{/if}}{{#if permanent}} permanent{{/if}}{{#if selection}} mh-cs-selected mh-cs-selected-{{selection}}{{/if}}" data-tag-id="{{id}}" data-item-id="{{id}}">
              <span class="mh-cs-burn {{burnState}}" aria-hidden="true"></span>
              {{#if isNew}}
              {{!-- A story tag just made here: its name is typed in place (tags-deck.js changeDeckField). --}}
              <input type="text" class="mh-cs-tag-name mh-cs-story-tag-input" id="{{@root.uid}}-story-{{id}}" data-deck-field="name" value="" placeholder="{{localize 'MistHUD.cardSheet.deck.namePlaceholder'}}" spellcheck="false" aria-label="{{localize 'MistHUD.cardSheet.deck.namePlaceholder'}}">
              {{else if edit}}
              <button type="button" class="mh-cs-tag-name mh-cs-edit-name" data-action="editTag" data-tooltip="{{localize 'MistHUD.cardSheet.editTag'}}">{{name}}</button>
              <button type="button" class="mh-cs-icon-btn mh-cs-delete" data-action="deleteTag" data-tooltip="{{localize 'MistHUD.cardSheet.deleteTagHint'}}" aria-label="{{localize 'MistHUD.cardSheet.deleteTag'}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
              {{else}}
              {{> "modules/mist-hud/templates/card-sheet/tag-name.hbs" tag=this}}
              {{/if}}
            </li>
            {{else}}
            <li class="mh-cs-none">{{localize "MistHUD.cardSheet.noStoryTags"}}</li>
            {{/each}}
          </ul>
        </div>
      </div>
      <footer class="mh-cs-band mh-cs-band-bottom"></footer>
    </section>

    <section class="mh-cs-face mh-cs-back"{{#unless card.flipped}} inert{{/unless}}>
      {{> "modules/mist-hud/templates/card-sheet/card-band.hbs" title=card.title icon=card.category label=card.themebook}}
      <div class="mh-cs-body">
        <h4 class="mh-cs-section">{{localize "CityOfMist.terms.short_desc"}}</h4>
        {{#if card.edit}}
        <textarea class="mh-cs-short-desc mh-cs-hand mh-cs-short-desc-input" id="{{@root.uid}}-character-short-desc" data-edit="actor" data-field="system.short_description" rows="2" aria-label="{{localize 'CityOfMist.terms.short_desc'}}" placeholder="{{localize 'CityOfMist.terms.short_desc'}}">{{card.shortDescription}}</textarea>
        {{else}}
        <p class="mh-cs-short-desc mh-cs-hand{{#unless card.shortDescription}} empty{{/unless}}">{{#if card.shortDescription}}{{card.shortDescription}}{{else}}—{{/if}}</p>
        {{/if}}
        {{#if card.buildUp}}
        <div class="mh-cs-buildup">
          <h4 class="mh-cs-section">
            <span class="mh-cs-section-label">{{card.buildUp.label}}</span>
            {{#if card.edit}}
            <button type="button" class="mh-cs-icon-btn" data-action="decBuildUp" data-tooltip="{{localize 'MistHUD.cardSheet.removeBuildUp'}}" aria-label="{{localize 'MistHUD.cardSheet.removeBuildUp'}}"><i class="fa-solid fa-minus" aria-hidden="true"></i></button>
            <button type="button" class="mh-cs-icon-btn" data-action="incBuildUp" data-tooltip="{{localize 'MistHUD.cardSheet.addBuildUp'}}" aria-label="{{localize 'MistHUD.cardSheet.addBuildUp'}}"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
            {{/if}}
          </h4>
          <div class="mh-cs-buildup-track">
            <span class="mh-cs-pips">{{#each card.buildUp.pips}}<span class="mh-cs-pip{{#if filled}} filled{{/if}}"></span>{{/each}}</span>
            {{#if card.buildUp.unspent}}<span class="mh-cs-unspent">{{card.buildUp.unspentLabel}}</span>{{/if}}
            {{#if card.buildUp.canAdd}}
            <button type="button" class="mh-cs-icon-btn" data-action="addBUImprovement" data-tooltip="{{localize 'MistHUD.cardSheet.addBuildUpImprovement'}}" aria-label="{{localize 'MistHUD.cardSheet.addBuildUpImprovement'}}"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
            {{/if}}
          </div>
          {{#if card.buildUp.improvements.length}}
          <h5 class="mh-cs-subsection">{{card.buildUp.improvementsLabel}}</h5>
          <ul class="mh-cs-improvements mh-cs-bu-improvements">
            {{#each card.buildUp.improvements}}
            {{> "modules/mist-hud/templates/card-sheet/improvement.hbs" imp=this desc=true}}
            {{/each}}
          </ul>
          {{/if}}
        </div>
        {{/if}}
        <h4 class="mh-cs-section">{{localize "CityOfMist.terms.biography"}}</h4>
        {{#if card.edit}}
        {{!-- The core editor: shows the enriched text, with its own edit
              toggle; saving fires "change", handled by the sheet. --}}
        <prose-mirror class="mh-cs-scroll mh-cs-biography" name="system.biography" data-edit="actor" data-field="system.biography" value="{{card.biographyRaw}}" toggled>{{{card.biography}}}</prose-mirror>
        {{else}}
        <div class="mh-cs-scroll mh-cs-biography">
          {{#if card.biography}}{{{card.biography}}}{{else}}<p class="mh-cs-none">—</p>{{/if}}
        </div>
        {{/if}}
      </div>
      <footer class="mh-cs-band mh-cs-band-bottom"></footer>
    </section>

  </div>
</article>
