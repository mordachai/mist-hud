<form class="status-screen">
    <div class="status-screen-header">
        <div class="statuses-screen-title" title="{{localize "MistHUD.statusScreen.dragHint"}}">{{localize "MistHUD.statusScreen.title"}}</div>
        <div class="status-screen-buttons">
        <button type="button" class="mh-sample-csv" title="{{localize "MistHUD.statusScreen.sampleHint"}}">
            <i class="fa-regular fa-file-export"></i> {{localize "MistHUD.statusScreen.sample"}}
        </button>
        <button type="button" class="mh-import-csv" title="{{localize "MistHUD.statusScreen.importHint"}}">
            <i class="fas fa-file-csv"></i> {{localize "MistHUD.statusScreen.import"}}
        </button>
        <button type="button" class="mh-reset-json" title="{{localize "MistHUD.statusScreen.resetHint"}}">
            <i class="fas fa-undo"></i> {{localize "MistHUD.statusScreen.reset"}}
        </button>
        </div>
    </div>

    {{#if enableTabs}}
        <nav class="status-tabs">
            {{#each statusesGrouped as |statuses category|}}
                <button type="button" class="status-tab" data-tab="{{category}}">{{category}}</button>
            {{/each}}
        </nav>

        <div class="status-tab-content">
            {{#each statusesGrouped as |statuses category|}}
                <div class="status-category-list tab-content" data-tab="{{category}}" style="display: none;">
                    {{#each statuses as |status|}}
                    <div class="status-group-container">{{status.status_type}}:
                        <ul>
                            {{#each status.status_scale as |statusItem|}}
                                <li class="npc-status">{{statusItem}}</li>
                            {{/each}}
                        </ul></div>
                    {{/each}}
                </div>
            {{/each}}
        </div>
    {{else}}
        {{#each statuses as |status|}}
            <div class="status-category-list">
                <div class="status-group-container">{{status.status_type}}:</div>
                <ul>
                    {{#each status.status_scale as |statusItem|}}
                        <li class="npc-status">{{statusItem}}</li>
                    {{/each}}
                </ul>
            </div>
        {{/each}}
    {{/if}}
</form>
