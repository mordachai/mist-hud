<div class="mh-hud{{#if essenceClass}} mh-bg-{{essenceClass}}{{/if}}"{{#if comTone}} style="--mh-tone-a: {{comTone}}"{{/if}}>

  {{!-- ── Roll Bar ── --}}
  <div class="mh-roll-bar">
    {{#each moveGroups}}
    <div class="mh-roll-container mh-move-group-{{key}}" data-group-index="{{index}}" data-label="{{label}}" {{#unless first}}style="display:none"{{/unless}}>
      {{#each moves}}
        {{#if useText}}
          <button class="mh-roll-button" data-move-id="{{this.id}}" title="{{this.tooltip}}">
            <div class="mh-roll-main">{{this.abbr}}</div>
          </button>
        {{else}}
          <button class="mh-roll-button mh-roll-button-img" data-move-id="{{this.id}}" title="{{this.tooltip}}">
            <img src="{{this.imgSrc}}" alt="{{this.name}}" class="mh-roll-img">
          </button>
        {{/if}}
      {{/each}}
    </div>
    {{/each}}
    {{#if isCityOfMist}}
    <button class="mh-roll-button-img mh-dynamite-toggle" title="{{localize "CityOfMist.terms.dynamite"}}">
      <img src="{{dynamiteImg}}" class="mh-roll-img" alt="Dynamite">
    </button>
    {{/if}}
    {{#if multipleMoveGroups}}
    <button class="mh-roll-toggle" title="{{moveGroups.1.label}}">
      <i class="fa-solid fa-caret-up"></i>
    </button>
    {{/if}}
  </div>

  {{!-- ── Main Content ── --}}
  <div class="mh-content-container">
    <div class="mh-content">

      {{!-- Themes, Tags, etc. --}}
      {{#each themes}}
      <div class="theme-container-{{category}}">

        <div class="mh-theme-header {{category}}">
          <span class="{{iconClass}}" data-theme-id="{{id}}" data-theme-type="{{category}}"></span>
          {{#if (eq ../activeSystem "city-of-mist")}}
            <span class="mh-theme-name mh-theme-name-com-{{category}}">{{themeName}}</span>
            {{#if unspent_upgrades}}
              <span class="mh-improvement-marker {{category}}">
                {{#if nascent}}
                  <i class="fa-solid fa-bolt nascent-upgrade-indicator" title="{{localize "MistHUD.hud.nascentUpgrade"}}"></i>
                {{else}}
                  {{#times unspent_upgrades}}<i class="fa-light fa-star"></i>{{/times}}
                {{/if}}
              </span>
            {{/if}}
          {{/if}}
          {{#if (eq ../activeSystem "otherscape")}}
            <span class="mh-theme-name mh-theme-name-com-{{category}}">
              {{themebookLabel}}
              {{#if unspent_upgrades}}
                <span class="mh-improvement-marker {{category}}">
                  {{#if nascent}}
                    <i class="fa-solid fa-bolt nascent-upgrade-indicator" title="{{localize "MistHUD.hud.nascentUpgrade"}}"></i>
                  {{else}}
                    {{#times unspent_upgrades}}<i class="fa-light fa-star"></i>{{/times}}
                  {{/if}}
                </span>
              {{/if}}
            </span>
          {{/if}}
          {{#if (eq ../activeSystem "legend")}}
            <span class="mh-theme-name mh-theme-name-com-{{category}}">
              <span class="mh-theme-name-text" title="{{themebookLabel}}">{{themebookLabel}}</span>
              {{#if unspent_upgrades}}
                <span class="mh-improvement-marker {{category}}">
                  {{#if nascent}}
                    <i class="fa-solid fa-bolt nascent-upgrade-indicator" title="{{localize "MistHUD.hud.nascentUpgrade"}}"></i>
                  {{else}}
                    {{#times unspent_upgrades}}<i class="fa-light fa-star"></i>{{/times}}
                  {{/if}}
                </span>
              {{/if}}
            </span>
          {{/if}}
        </div>

        <!-- Power Tags -->
        <ul class="mh-tags">
          {{#each powerTags}}
            <li class="mh-power-tag {{this.cssClass}} {{../category}} {{#if isTitle}}mh-title-tag{{/if}} {{#if depth}}mh-nested-tag{{/if}} {{#if selected}}selected{{/if}}"
                {{#if depth}}style="--mh-tag-depth: {{depth}}"{{/if}}
                data-id="{{this.id}}"
                data-theme-id="{{this.themeId}}"
                data-actor-id="{{actorId}}">
              <div class="mh-burn-toggle burn-icon {{this.burnState}} {{../category}}"></div>
              <div class="mh-tag-text {{../category}}">{{this.tagName}}</div>
            </li>
          {{/each}}
        </ul>

        <!-- Weakness Tags -->
        <ul class="mh-tags">
          {{#each weaknessTags}}
            <li class="mh-weakness-tag {{this.cssClass}} {{#if inverted}}inverted{{/if}} {{#if selected}}selected{{/if}}"
                data-id="{{this.id}}"
                data-theme-id="{{this.themeId}}"
                data-actor-id="{{actorId}}">
              <span class="mh-weakness-toggle clickable" data-id="{{this.id}}">
                {{{this.inversionIcon}}}
              </span>
              <span class="mh-tag-text">{{this.tagName}}</span>
            </li>
          {{/each}}
        </ul>
      </div>
      {{/each}}

      {{!-- Crew themes, then the active extra (danger) theme: right after the
           character's own themes, so in the wide layout they pair up --}}
      {{#if linkedThemes.length}}
        {{#each linkedThemes}}
          <div class="theme-container {{category}}">
            <div class="mh-theme-header {{category}}">
              <span class="{{iconClass}}" data-theme-id="{{id}}" data-theme-type="{{themeType}}" data-mystery="{{mystery}}"></span>
              {{#if (eq ../activeSystem "city-of-mist")}}
                <span class="mh-theme-name mh-theme-name-com-{{category}}">
                  {{name}} {{themeName}}
                  {{#if unspent_upgrades}}
                    <span class="mh-improvement-marker {{category}}">
                      {{#times unspent_upgrades}}<i class="fa-solid fa-star"></i>{{/times}}
                    </span>
                  {{/if}}
                </span>
              {{/if}}
              {{#if (eq ../activeSystem "otherscape")}}
                <span class="mh-theme-name mh-theme-name-com-{{category}}">
                  {{crewName}}
                  {{#if unspent_upgrades}}
                    <span class="mh-improvement-marker {{category}}">
                      {{#times unspent_upgrades}}<i class="fa-solid fa-star"></i>{{/times}}
                    </span>
                  {{/if}}
                </span>
              {{/if}}
              {{#if (eq ../activeSystem "legend")}}
                <span class="mh-theme-name mh-theme-name-com-{{category}}">
                  <span class="mh-theme-name-text" title="{{crewName}}">{{crewName}}</span>
                  {{#if unspent_upgrades}}
                    <span class="mh-improvement-marker {{category}}">
                      {{#if nascent}}
                        <i class="fa-solid fa-bolt nascent-upgrade-indicator" title="{{localize "MistHUD.hud.nascent"}}"></i>
                      {{else}}
                        {{#times unspent_upgrades}}<i class="fa-light fa-star"></i>{{/times}}
                      {{/if}}
                    </span>
                  {{/if}}
                </span>
              {{/if}}
            </div>
            <ul class="mh-tags">
              {{#each powerTags}}
                <li class="mh-power-tag {{this.cssClass}} {{../category}} {{#if isTitle}}mh-title-tag{{/if}} {{#if depth}}mh-nested-tag{{/if}} {{#if selected}}selected{{/if}} {{#if crispy}}mh-crispy{{/if}}"
                    {{#if depth}}style="--mh-tag-depth: {{depth}}"{{/if}}
                    data-id="{{this.id}}"
                    data-actor-id="{{actorId}}"
                    data-theme-id="{{this.themeId}}">
                  <div class="mh-burn-toggle burn-icon {{this.burnState}} {{../category}}"></div>
                  <div class="mh-tag-text {{../category}}">{{this.tagName}}</div>
                </li>
              {{/each}}
            </ul>
            <ul class="mh-tags">
              {{#each weaknessTags}}
                <li class="mh-weakness-tag {{this.cssClass}} {{../category}} {{#if selected}}selected{{/if}}"
                    data-id="{{this.id}}"
                    data-actor-id="{{actorId}}"
                    data-theme-id="{{this.themeId}}">
                  <span class="mh-weakness-toggle {{../category}} clickable {{#if this.inverted}}inverted{{else}}default{{/if}}" data-id="{{this.id}}">
                    {{{this.inversionIcon}}}
                  </span>
                  <span class="mh-tag-text">{{this.tagName}}</span>
                </li>
              {{/each}}
            </ul>
          </div>
        {{/each}}
      {{/if}}

      <!-- Loadout (Otherscape / Legend) -->
      {{#if (or isOtherscape isLegend)}}
        <div class="theme-container mh-loadout-container">
          <div class="mh-theme-header neutral loadout mh-title-container" title="{{localize "MistHUD.hud.manageLoadout" name=loadoutName}}">
            <span class="mh-theme-name mh-theme-name-neutral">{{loadoutName}}</span>
            <span class="mh-theme-icon-notip loadout"></span>
          </div>
          {{!-- A loadout weakness row; sits right under its loadout tag (a
                sibling li, so the tag's selected/burned styles don't reach it). --}}
          {{#*inline "loadoutWeakness"}}
            <li class="mh-weakness-tag {{#if nested}}mh-loadout-weakness{{/if}} {{cssClass}} {{#if inverted}}inverted{{/if}} {{#if selected}}selected{{/if}}"
                data-id="{{id}}"
                data-theme-id="{{themeId}}"
                data-actor-id="{{actorId}}">
              <span class="mh-weakness-toggle clickable" data-id="{{id}}">
                {{{inversionIcon}}}
              </span>
              <span class="mh-tag-text">{{tagName}}</span>
            </li>
          {{/inline}}
          {{!-- Only the activated loadout tags, each followed by its weakness
                (as on the sheet). Clicking the header opens the activation
                popup (_showLoadoutPopup). --}}
          <ul class="mh-tags">
            {{#each loadoutTags}}
              <li class="mh-loadout-tag {{this.cssClass}} {{#if selected}}selected{{/if}}"
                  data-id="{{this.id}}"
                  data-theme-id="{{this.themeId}}"
                  data-actor-id="{{actorId}}">
                <span class="mh-burn-toggle burn-icon {{this.burnState}}"></span>
                <span class="mh-tag-text">{{this.tagName}}</span>
              </li>
              {{#each weaknesses}}{{> loadoutWeakness nested=true}}{{/each}}
            {{/each}}
            {{!-- Weaknesses whose loadout tag no longer exists --}}
            {{#each loadoutWeaknessTags}}{{> loadoutWeakness}}{{/each}}
          </ul>
        </div>
      {{/if}}

      <!-- Story Tags -->
      {{!-- No loadout (City of Mist): the tags take the whole row in the wide layout --}}
      <div class="mh-story-tags-container {{#unless (or isOtherscape isLegend)}}mh-story-tags-wide{{/unless}}">
        <div class="mh-theme-header neutral extras mh-title-container">
          <div class="mh-title-container">
            <span class="mh-theme-icon-notip storytag"></span>
            <span class="mh-theme-name mh-theme-name-neutral">
              {{localize "CityOfMist.terms.tags"}}
            </span>
          </div>
          <a class="mh-create-story-tag" data-owner-id="{{actorId}}" title="{{localize "MistHUD.hud.createTag"}}">
            <i class="fa-regular fa-circle-plus"></i>
          </a>
        </div>
        <ul class="mh-tags">
          {{#each storyTags}}
            <li class="mh-story-tag {{this.cssClass}} {{#if temporary}}temporary{{/if}} {{#if selected}}selected{{/if}}"
                data-id="{{this.id}}"
                data-theme-id="{{this.themeId}}"
                data-actor-id="{{actorId}}"
                data-temporary="{{this.temporary}}"
                data-permanent="{{this.permanent}}">
              <span class="mh-burn-toggle burn-icon {{this.burnState}}"></span>
              <span class="mh-tag-text {{#if temporary}}temporary{{/if}}">
                {{this.tagName}}
                {{#if temporary}}<i class="fa-regular fa-hourglass-half"></i>{{/if}}
                {{#if permanent}}<i class="fa-solid fa-gem"></i>{{/if}}
              </span>
              <span class="mhr-mls mh-story-toggle clickable {{#if this.inverted}}inverted{{else}}default{{/if}}" data-id="{{this.id}}">
                {{{this.inversionIcon}}}
              </span>
            </li>
          {{/each}}
        </ul>
      </div>

      <!-- Statuses -->
      <div class="mh-statuses-container">
        <div class="mh-theme-header neutral extras mh-title-container">
          <div class="mh-title-container">
            <span class="mh-theme-icon-notip statuses"></span>
            <span class="mh-theme-name mh-theme-name-neutral">{{localize "CityOfMist.terms.statuses"}}</span>
          </div>
          <a class="mh-create-status" title="{{localize "MistHUD.hud.createStatus"}}">
            <i class="fa-regular fa-circle-plus"></i>
          </a>
        </div>
        <div class="mh-statuses-list">
          {{#each statuses}}
            <div class="mh-status {{this.statusType}} {{#if selected}}selected{{/if}} {{#if temporary}}temporary{{/if}}"
                 data-status-name="{{this.name}}"
                 data-status-id="{{this.id}}"
                 data-owner-id="{{actorId}}"
                 data-tier="{{this.tier}}"
                 data-temporary="{{this.temporary}}"
                 data-permanent="{{this.permanent}}">
              {{#if temporary}}<i class="fa-regular fa-hourglass-half"></i>{{/if}}
              {{#if permanent}}<i class="fa-solid fa-gem"></i>{{/if}}
              {{this.name}}-{{this.tier}}
            </div>
          {{/each}}
        </div>
      </div>


    </div>
  </div>

  {{!-- ── Footer ── --}}
  <div class="mh-footer">
    <div class="mh-modifier-bar">
      <div id="mh-mod-decrease" class="mh-mod-button">-</div>
      <input type="text" id="mh-mod-value" value="{{modifier}}" />
      <div id="mh-mod-increase" class="mh-mod-button">+</div>
      <span class="mh-power-indicator">{{#if (gt modifier 0)}}+{{/if}}{{modifier}}</span>
    </div>

    {{#if helpHurtMessages}}
      {{#if isCityOfMist}}
        <div id="mh-help-hurt-messages" class="mh-help-hurt-messages">
          {{#each helpHurtMessages}}
            <div class="mh-help-hurt-items">
              <div class="relationship-message {{this.type}}">
                <img src="{{this.giverToken}}" alt="{{this.giverName}}" class="token-image-message" title="{{this.giverName}}">
                <span class="bonus-amount">
                  {{#if (eq this.type "help")}}+{{else}}-{{/if}}{{this.amount}}
                </span>
              </div>
            </div>
          {{/each}}
        </div>
      {{/if}}
    {{/if}}
  </div>

  {{!-- ── Sliding Panel (right) ── --}}
  <div class="mh-sliding-panel {{#if panelOpen}}open{{/if}}">
    <div class="mh-panel-ear">❯</div>
    <span class="mh-panel-badge"></span>
    <div class="mh-panel-content">

      {{#if quintessences.length}}
        <div class="section legends mh-quintessences">
          <div class="mh-theme-name title-effect">
            <i class="fa-solid fa-sun"></i> {{localize "MistHUD.hud.quintessence"}}
          </div>
          {{#each quintessences}}
            <div class="improvement-container mh-quintessence{{#if uses.expended}} expended{{/if}}" data-id="{{id}}">
              <div class="mh-title-container">
                <span class="item-name">
                  <i class="fa-solid fa-star mh-improvement-star"></i>
                  <span>{{name}}</span>
                </span>
                {{#if pips.length}}
                  <span class="mh-quint-uses" data-tooltip="{{localize "MistHUD.hud.quintessenceUses"}}">
                    {{#each pips}}
                      <i class="mh-quint-pip {{#if spent}}spent fa-regular{{else}}fa-solid{{/if}} fa-circle"></i>
                    {{/each}}
                  </span>
                {{/if}}
              </div>
              {{#if description}}
                <div class="item-description">{{description}}</div>
              {{/if}}
              {{#if choiceItem}}
                <div class="item-choice"><i class="fa-solid fa-right"></i> {{choiceItem}}</div>
              {{/if}}
            </div>
          {{/each}}
        </div>
        <hr class="panel-divider mh-fade-divider" />
      {{/if}}

      {{#if isOtherscape}}
        <div class="section otherscape{{#if essenceBurned}} mh-essence-burned{{/if}}">
          <div class="mh-theme-name mh-theme-name-neutral mh-essence-title">
            <div>Essence:</div>
            <div class="mh-essence-title {{essenceClass}}">{{essence}}</div>
            <span class="mh-essence-burn burn-icon {{#if essenceBurned}}burned{{else}}unburned{{/if}} clickable"
                  data-tooltip="{{#if essenceBurned}}{{localize "MistHUD.essence-burned"}}{{else}}{{localize "MistHUD.essence-burn"}}{{/if}}"></span>
          </div>
          <div class="mh-essence-chart {{essenceClass}}">
            <img src="modules/mist-hud/ui/essences/{{essenceImage}}" alt="{{essence}}" />
          </div>
          {{{essenceText}}}
        </div>
        <hr class="panel-divider mh-fade-divider" />
      {{/if}}


      {{!-- Relationship tags (Otherscape crew relationships / Legend fellowship).
           Rows are also .mh-story-tag so they share its select / burn / invert /
           edit / delete behaviour. --}}
      {{#if showRelationships}}
        <div class="section mh-relationships">
          <div class="mh-theme-name title-effect mh-title-container">
            <div><i class="fa-solid fa-users"></i> {{relationshipsLabel}}</div>
            <a class="mh-create-relationship" title="{{localize "MistHUD.hud.createRelationship"}}"><i class="fas fa-plus"></i></a>
          </div>
          <ul class="mh-tags">
            {{#each relationshipTags}}
              <li class="mh-story-tag mh-relationship-tag {{this.cssClass}} {{#if selected}}selected{{/if}} {{#if inverted}}inverted{{/if}}"
                  data-id="{{this.id}}"
                  data-actor-id="{{actorId}}">
                <span class="mh-burn-toggle burn-icon {{this.burnState}}"></span>
                <span class="mh-tag-text">{{this.tagName}}{{#if targetName}} <span class="mh-relationship-target">({{targetName}})</span>{{/if}}</span>
                <span class="mhr-mls mh-story-toggle clickable {{#if inverted}}inverted{{else}}default{{/if}}" data-id="{{this.id}}">
                  {{{this.inversionIcon}}}
                </span>
              </li>
            {{/each}}
          </ul>
          {{#each relationshipSlots}}
            <a class="mh-relationship-slot mh-create-relationship" data-target-id="{{id}}">
              <img src="{{img}}" alt="">
              <span><span class="mh-relationship-who">{{name}}</span>{{localize "MistHUD.hud.addRelationship"}}</span>
            </a>
          {{/each}}
        </div>
        <hr class="panel-divider" />
      {{/if}}

      {{#if hasImprovements}}
        <div class="section improvements">
          {{#if isCityOfMist}}
            <div class="mh-theme-name title-effect">
              <i class="fa-light fa-star"></i> {{localize "CityOfMist.terms.improvements"}}
            </div>
          {{/if}}
          {{#if isOtherscape}}
            <div class="mh-theme-name title-effect">
              <i class="fa-light fa-star"></i> THEME SPECIALS
            </div>
          {{/if}}
          {{#each improvements}}
            <div class="theme-container">
              <div class="mh-theme-name mh-title-container mh-improvement-theme">
                <div class="theme-type {{themeType}}" data-theme-id="{{id}}">{{this.themebookName}}</div>
              </div>
              {{#each this.improvements}}
                <div class="improvement-container">
                  <div class="mh-title-container">
                    <span class="item-name">
                      <i class="fa-solid fa-star mh-improvement-star"></i>
                      <span>{{this.name}}{{#if (gt this.uses.max 0)}} - {{this.uses.current}}/{{this.uses.max}}{{/if}}</span>
                    </span>
                  </div>
                  {{#if this.description}}
                    <div class="item-description">{{this.description}}</div>
                  {{/if}}
                  {{#if this.choiceItem}}
                    <div class="item-choice"><i class="fa-solid fa-right"></i> {{this.choiceItem}}</div>
                  {{/if}}
                </div>
              {{/each}}
            </div>
          {{/each}}
        </div>
      {{/if}}

      {{#if isCityOfMist}}
        <div class="section relationships">
          <div class="mh-theme-name title-effect"><i class="fa-solid fa-users"></i> {{localize "CityOfMist.terms.help"}} &amp; {{localize "CityOfMist.terms.hurt"}}</div>
          {{#each helpItems}}
            <div class="relationship-item">
              <img src="{{this.target.tokenImage}}" alt="{{this.target.name}}" class="token-image" />
              <span class="item-name">{{this.target.name}} (+{{this.amount}})</span>
              <input type="checkbox" class="help-toggle"
                data-id="{{this.id}}" data-actor-id="{{actorId}}"
                data-target-id="{{this.target.id}}" data-amount="{{this.amount}}"
                {{#if this.active}}checked{{/if}}>
            </div>
          {{/each}}
          {{#each hurtItems}}
            <div class="relationship-item">
              <img src="{{this.target.tokenImage}}" alt="{{this.target.name}}" class="token-image" />
              <span class="item-name">{{this.target.name}} (-{{this.amount}})</span>
              <input type="checkbox" class="hurt-toggle"
                data-id="{{this.id}}" data-actor-id="{{actorId}}"
                data-target-id="{{this.target.id}}" data-amount="{{this.amount}}"
                {{#if this.active}}checked{{/if}}>
            </div>
          {{/each}}
        </div>

        <hr class="panel-divider" />

        <div class="section clues">
          <div class="mh-theme-name title-effect mh-title-container">
            <div><i class="fa-solid fa-magnifying-glass"></i> {{localize "CityOfMist.terms.clues"}}</div>
            <a class="create-clue" title="{{localize "MistHUD.hud.createClue"}}"><i class="fas fa-plus"></i></a>
          </div>
          {{#each clueItems}}
            <div class="clue-container" data-clue-id="{{this.id}}" data-owner-id="{{this.actorId}}">
              <div class="mh-title-container">
                <div class="item-name">{{this.name}} ({{this.amount}})</div>
                <a class="clue-delete" title="{{localize "MistHUD.hud.deleteClue"}}"><i class="fas fa-trash"></i></a>
              </div>
              {{#if this.partial}}
                <div class="partial-icon" title="{{localize "CityOfMist.terms.partialClue"}}">
                  🧩 {{localize "CityOfMist.terms.partialClue"}}
                </div>
              {{/if}}
              <div class="item-details">
                <span class="detail-label">{{localize "CityOfMist.terms.clueSource"}}:</span>
                <span class="detail-text">{{this.source}}</span><br>
                <span class="detail-label">{{localize "CityOfMist.terms.clueMethod"}}:</span>
                <span class="detail-text">{{this.method}}</span>
              </div>
            </div>
          {{/each}}
        </div>

        <hr class="panel-divider" />

        <div class="section juice">
          <div class="mh-theme-name title-effect mh-title-container">
            <div><i class="fa-solid fa-bolt"></i> {{localize "CityOfMist.terms.juice"}}</div>
            <a class="create-juice" title="{{localize "MistHUD.hud.createJuice"}}"><i class="fas fa-plus"></i></a>
          </div>
          {{#each juiceItems}}
            <div class="juice-container" data-juice-id="{{this.id}}" data-owner-id="{{this.actorId}}">
              <div class="mh-title-container">
                <div class="item-name">{{this.name}} ({{this.amount}})</div>
                <a class="juice-delete" title="{{localize "MistHUD.hud.deleteJuice"}}"><i class="fas fa-trash"></i></a>
              </div>
              <div class="item-details">
                <span class="detail-label">{{localize "CityOfMist.terms.clueSource"}}:</span>
                <span class="detail-text">{{this.source}}</span><br>
                <span class="detail-label">{{localize "CityOfMist.terms.clueMethod"}}:</span>
                <span class="detail-text">{{this.method}}</span>
              </div>
            </div>
          {{/each}}
        </div>
      {{/if}}

      {{#unless (or isCityOfMist (or isOtherscape isLegend))}}
        <div class="section fallback">
          <div class="mh-theme-name"><i class="fa-solid fa-exclamation-triangle"></i> No Content Available</div>
        </div>
      {{/unless}}

    </div>
  </div>

</div>
