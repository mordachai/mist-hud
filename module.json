{
  "id": "mist-hud",
  "title": "Mist Engine HUD",
  "description": "A simple always-open, never-in-the-way HUD that allows players to select tags and statuses to be used in rolls. No questions, no menus, just select and roll using the moves in the hotbar.",
  "version": "2.50.2",
  "authors": [
    {
      "name": "Gus",
      "flags": {}
    },
    {
      "name": "Snagov",
      "flags": {}
    }
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "pt-BR",
      "name": "Português (Brasil)",
      "path": "lang/pt-br.json"
    }
  ],
  "compatibility": {
    "minimum": "13",
    "verified": "13"
  },
  "packs": [
    {
      "name": "mist-hud-macros",
      "label": "Mist HUD Macros",
      "path": "packs/mist-hud-macros",
      "type": "Macro",
      "system": "city-of-mist",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    }
  ],
  "esmodules": [
    "scripts/constants.js",
    "scripts/settings.js",
    "scripts/move-layout.js",
    "scripts/hud-state.js",
    "scripts/getters.js",
    "scripts/notifications.js",
    "scripts/bonus-manager.js",
    "scripts/npc-helpers.js",
    "scripts/npc-influence-manager.js",
    "scripts/npc-influence.js",
    "scripts/status-screen.js",
    "scripts/player-hud.js",
    "scripts/npc-hud.js",
    "scripts/mh-dice.js",
    "scripts/init.js"
  ],
  "styles": [
    "styles/mist-hud.css",
    "styles/mh-npc-hud.css",
    "styles/npc-influence-manager.css"
  ],
  "socket": true,

  "url": "https://github.com/mordachai/mist-hud",
  "manifest": "https://github.com/mordachai/mist-hud/raw/main/module.json",
  "download": "https://github.com/mordachai/mist-hud/releases/latest/download/mist-hud.zip",
  "license": "https://raw.githubusercontent.mist/mordachai/mist-hud/refs/heads/main/LICENSE",
  "relationships": {
    "systems": [
      {
        "id": "city-of-mist",
        "type": "system",
        "compatibility": {}
      }
    ],
    "recommends": [
      {
        "id": "dice-so-nice",
        "type": "module",
        "compatibility": {}
      }
    ]
  }
}